#:kivy 2.0

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(8)

        Label:
            text: "Login"
            font_size: '24sp'

        TextInput:
            id: username
            hint_text: "Username"

        TextInput:
            id: password
            hint_text: "Password"
            password: True

        Button:
            text: "Login"
            on_release: root.login()

<LoadingScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(8)

        Label:
            text: "Loading..."
            font_size: '24sp'

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(8)

        Label:
            id: username_label
            text: root.username_label
            font_size: '24sp'

        ScrollView:
            size_hint_y: None
            height: self.minimum_height

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: sum(child.height for child in self.children)

                RecycleView:
                    id: task_list
                    viewclass: 'TaskItem'
                    data: root.tasks

                RecycleView:
                    id: notif_list
                    viewclass: 'NotifItem'
                    data: root.notifs

<RecycleItem>:
    orientation: 'horizontal'
    padding: dp(8)
    spacing: dp(8)

    Label:
        text: self.text
        font_size: '16sp'

<TaskItem@RecycleItem>:
    pass

<NotifItem@RecycleItem>:
    pass
